<Window x:Class="ControllerEngineeringStudio.SampleDocument.Views.NewSampleDocumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ControllerEngineeringStudio.SampleDocument.Views"
        mc:Ignorable="d"
        Title="NewSampleDocumentDialog" Height="200" Width="400"
        MinHeight="200" MinWidth="400" Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Content="File Name"/>
        <TextBox x:Name="_fileNameTextBox" Grid.Column="1"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                 Margin="10,0,0,0"/>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" IsDefault="True" Width="50" Command="{Binding OKCommand}"/>
            <Button Content="Cancel" IsCancel="True" Width="50" Command="{Binding CancelCommand}" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
