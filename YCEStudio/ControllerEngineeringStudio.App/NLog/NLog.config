<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <targets>
    <!--TODO：2026/07/30 (YE)Yuta Hatanaka ファイルの出力先や容量などが決まったら対応する-->
    <!--日付ごとにログファイルを出力-->
    <!--<target name="File"
            xsi:type="File"
            fileName="${specialfolder:folder=LocalApplicationData}/YASKAWA/${processname}/Logs/${date:format=yyyyMMdd}.log"
            layout="${longdate} [${threadid}] ${uppercase:${level}} - [${processid}]${message} ${exception:format=tostring}"
            archiveEvery="Day"
            archiveFileName="logs/${processname}_{#}.log.zip"
            archiveNumbering="DateAndSequence"
            archiveAboveSize="5242880"
            maxArchiveDays="365"
            enableArchiveFileCompression="true" />-->
    <target name="debug"
            xsi:type="Debugger"
            layout="${longdate}[${uppercase:${level}}][${callsite}][${message}]${onexception:[${exception:format=tostring}]}" />
  </targets>
  <rules>
    <!--MicrosoftのInfo以下のログは出力しない-->
    <!--<logger name="Microsoft.*"
            maxlevel="Info"
            final="true" />-->
    <!--Info以上のログをファイルに出力-->
    <!--<logger name="*"
            minlevel="Info"
            writeTo="file" />-->
    <logger name="*"
            minlevel="Trace"
            writeTo="debug" />
  </rules>
</nlog>