<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:res="clr-namespace:ControllerEngineeringStudio.App.Resources"
                    xmlns:commands="clr-namespace:ControllerEngineeringStudio.App.Commands"
                    xmlns:UIEx="clr-namespace:ControllerEngineeringStudio.UI.Extensions;assembly=ControllerEngineeringStudio.UI">
    <telerik:InvertedBooleanConverter x:Key="InvertedBooleanConverter"/>

    <Style TargetType="telerik:RadDocumentPane" BasedOn="{StaticResource RadPaneStyle}">
        <Setter Property="Header" Value="{Binding Header}" />
        <Setter Property="IsHidden" Value="{Binding IsHidden, Mode=TwoWay}" />
        <Setter Property="IsActive" Value="{Binding IsActive, Mode=TwoWay}" />
        <Setter Property="ContextMenuTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!--Telerik.Windows.Controls.Docking.xamlからコピペ-->
                    <telerik:RadContextMenu InheritDataContext="False">
                        <telerik:RadMenuItem Header="{x:Static res:Strings.Floating}"
                                             IsChecked="{Binding IsFloatingOnly}"
                                             Command="telerik:RadDockingCommands.Floating"
                                             CommandParameter="{Binding}" CommandTarget="{Binding}"/>
                        <telerik:RadMenuItem Header="{x:Static res:Strings.Dockable}"
                                             IsChecked="{Binding IsDockableOptionChecked}"
                                             Command="telerik:RadDockingCommands.Dockable"
                                             CommandParameter="{Binding}" CommandTarget="{Binding}"/>
                        <telerik:RadMenuItem Header="{x:Static res:Strings.TabbedDocument}"
                                             IsChecked="{Binding IsInDocumentHost}"
                                             Command="telerik:RadDockingCommands.TabbedDocument"
                                             CommandParameter="{Binding}" CommandTarget="{Binding}"/>
                        <telerik:RadMenuItem Header="{x:Static res:Strings.Close}"
                                             IsChecked="{Binding IsHidden}"
                                             Command="telerik:RadDockingCommands.Close"
                                             CommandParameter="{Binding}" CommandTarget="{Binding}"/>
                        <telerik:RadMenuItem Header="{x:Static res:Strings.CloseAll}"
                                             Command="{Binding 
                                                Source={UIEx:Resolve Type={x:Type commands:RadDockingCommandsEx}},
                                                Path=CloseAllCommand}"/>
                        <telerik:RadMenuItem Header="{x:Static res:Strings.CloseOthers}"
                                             Command="{Binding 
                                                Source={UIEx:Resolve Type={x:Type commands:RadDockingCommandsEx}},
                                                Path=CloseOthersCommand}"
                                             CommandParameter="{Binding DataContext}"/>
                    </telerik:RadContextMenu>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="telerik:RadPane" BasedOn="{StaticResource RadPaneStyle}">
        <Setter Property="CanDockInDocumentHost" Value="False"/>
        <Setter Property="Header" Value="{Binding Header}" />
        <Setter Property="IsHidden" Value="{Binding IsHidden, Mode=TwoWay}" />
        <Setter Property="IsActive" Value="{Binding IsActive, Mode=TwoWay}" />
        <Setter Property="ContextMenuTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!--Telerik.Windows.Controls.Docking.xamlからコピペ-->
                    <telerik:RadContextMenu InheritDataContext="False">
                        <telerik:RadMenuItem Header="{x:Static res:Strings.Floating}"
                                             IsChecked="{Binding IsFloatingOnly}"
                                             Command="telerik:RadDockingCommands.Floating"
                                             CommandParameter="{Binding}" CommandTarget="{Binding}"/>
                        <telerik:RadMenuItem Header="{x:Static res:Strings.Dockable}"
                                             IsChecked="{Binding IsDockableOptionChecked}"
                                             Command="telerik:RadDockingCommands.Dockable"
                                             CommandParameter="{Binding}" CommandTarget="{Binding}"/>
                        <telerik:RadMenuItem Header="{x:Static res:Strings.AutoHide}"
                                             IsChecked="{Binding IsPinned, Converter={StaticResource InvertedBooleanConverter}}"
                                             Command="telerik:RadDockingCommands.Pin"
                                             CommandParameter="{Binding}" CommandTarget="{Binding}"/>
                        <telerik:RadMenuItem Header="{x:Static res:Strings.Hide}"
                                             IsChecked="{Binding IsHidden}"
                                             Command="telerik:RadDockingCommands.Close"
                                             CommandParameter="{Binding}" CommandTarget="{Binding}"/>
                    </telerik:RadContextMenu>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>