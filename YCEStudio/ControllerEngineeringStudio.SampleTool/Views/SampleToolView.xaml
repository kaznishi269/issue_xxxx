<UserControl x:Class="ControllerEngineeringStudio.SampleTool.Views.SampleToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:ControllerEngineeringStudio.SampleTool.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <telerik:RadBusyIndicator IsBusy="False" BusyContent="{Binding BusyContent}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <GroupBox Header="レジスタモニタ">
                <Grid VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Content="レジスタ" VerticalAlignment="Center" Margin="2"/>
                    <TextBox Grid.Column="1" Text="{Binding RegisterName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" VerticalAlignment="Center" Width="100" Margin="2" IsReadOnly="True"/>
                    <Label Grid.Column="2" Content="{Binding RegisterValue}" VerticalAlignment="Center" Width="100" Margin="2"/>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="変数レジスタ検索">
                <Grid VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Content="変数" VerticalAlignment="Center" Margin="2"/>
                    <TextBox Grid.Column="1" Text="{Binding FindVariableName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" VerticalAlignment="Center" Width="100" Margin="2" />
                    <Label Grid.Column="2" Content="{Binding FindResultRegisterName}" VerticalAlignment="Center" Width="100" Margin="2"/>
                    <Label Grid.Row="1" Content="レジスタ" VerticalAlignment="Center" Margin="2"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FindRegisterName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" VerticalAlignment="Center" Width="100" Margin="2" />
                    <Label Grid.Row="1" Grid.Column="2" Content="{Binding FindResultVariableName}" VerticalAlignment="Center" Width="100" Margin="2"/>
                    <Button Grid.Row="2" Content="検索" Command="{Binding FindCommand}"/>
                </Grid>
            </GroupBox>
        </Grid>
    </telerik:RadBusyIndicator>
</UserControl>
