<UserControl x:Class="ControllerEngineeringStudio.AiChatTool.Views.AiChatToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:ControllerEngineeringStudio.AiChatTool.Views"
             xmlns:localConverters="clr-namespace:ControllerEngineeringStudio.AiChatTool.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <telerik:RadChat IsSpeechToTextButtonVisible="False"
                         DataSource="{Binding Messages}"
                         CurrentAuthor="{Binding CurrentAuthor}"
                         TypingIndicatorText="{Binding TypingIndicatorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TypingIndicatorVisibility="{Binding IsTypingIndicator, Converter={StaticResource BooleanToVisibilityConverter}}"
                         SendMessage="OnRadChatSendMessage">
            <telerik:RadChat.MessageConverter>
                <localConverters:ChatMessageConverter/>
            </telerik:RadChat.MessageConverter>
        </telerik:RadChat>
    </Grid>
</UserControl>
